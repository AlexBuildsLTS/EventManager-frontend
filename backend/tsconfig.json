{
  "compilerOptions": {
    "target": "ES2020", // Or a more recent version if needed
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "./dist", //  Add output directory
    "rootDir": "./src", // Add root directory
    "sourceMap": true, // Enable source maps
    "declaration": true // Generate declaration files (optional)
  },
  "exclude": ["node_modules", "dist"], // Exclude node_modules and the output directory
  "include": ["src/**/*"] // Correctly include only src
}
